<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy Manifest (M7) — PeachTV+ iOS.
  Apple l'exige à l'upload. On déclare :
    - aucun tracking (NSPrivacyTracking = false, aucun domaine) ;
    - aucune donnée collectée (NSPrivacyCollectedDataTypes vide) — les identifiants Xtream
      restent LOCAUX (Keychain), jamais transmis à un tiers ni à nous ;
    - les « API à raison requise » réellement utilisées + leur code de raison approuvé :
        * UserDefaults (CA92.1) — consentement HTTP par hôte (CleartextConsent) ;
        * Espace disque (E174.1) — vérifier l'espace avant un téléchargement (DiskSpaceGuard).
  Si de nouvelles API à raison requise sont introduites, les ajouter ici.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
